{
  "name": "@lordierclaw/bluenote-core",
  "version": "0.1.1",
  "description": "Headless BlueNote core for local-first Markdown notes.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/fix-esm-extensions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "js-yaml": "4.1.1",
    "minisearch": "6.3.0",
    "sql.js": "1.10.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.18",
    "@types/node": "20.19.0",
    "typescript": "5.8.3"
  }
}
